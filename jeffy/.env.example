# Jeffy — copy to .env.local and fill in. Never commit .env.local.
#
# These two ship in the app bundle and are safe to: every table is behind RLS
# and the anon key grants nothing on its own.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-ANON-KEY

# Optional: overrides the iOS bundle identifier / Android package.
# EXPO_PUBLIC_BUNDLE_ID=com.jeffy.app

# Set by `eas init`; only needed for EAS builds.
# EAS_PROJECT_ID=

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY. These are set with `supabase secrets set`, never here and
# never in the app bundle.
#
#   ANTHROPIC_API_KEY=       # all AI features
#   UPCITEMDB_API_KEY=       # optional; free tier works unauthenticated
#   SUPABASE_SERVICE_ROLE_KEY=  # injected into Edge Functions automatically
# ---------------------------------------------------------------------------
