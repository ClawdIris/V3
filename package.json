{
  "name": "casabe-connect-v3",
  "version": "3.0.0",
  "description": "Casabe Connect V3 - Security Hardened Parcel Shipping Platform",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "NODE_ENV=development node backend/server.js",
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:json": "playwright test --reporter=json",
    "verify": "playwright test",
    "smoke": "node scripts/post-deploy-smoke.js",
    "build-guard": "bash scripts/netlify-build-guard.sh",
    "smoke:auth": "playwright test authenticated-render.spec.js"
  },
  "keywords": [
    "shipping",
    "parcel",
    "casabe",
    "track",
    "security"
  ],
  "author": "Casabe Team",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.38.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  }
}
