# Casabe Connect V3 - Environment Configuration
# 
# SECURITY: This file is for reference only.
# Never commit actual secrets. Use .env.local for development.
# Production: Inject via environment at deployment time.

# Supabase Configuration (REQUIRED)
# Obtain from: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# API Backend (REQUIRED for security)
# Must implement authentication, authorization, and input validation
VITE_API_BASE_URL=https://api.casabe.local/v1

# Feature Flags
VITE_ENABLE_RLS=true
VITE_ENABLE_AUTH_CHECKS=true
VITE_ENABLE_INPUT_VALIDATION=true

# Logging
VITE_LOG_LEVEL=info
VITE_DEBUG_MODE=false
